{
  "name": "@wizzboy55/y-prosemirror",
  "version": "2.0.0-6",
  "description": "Prosemirror bindings for Yjs v14 (fork of @y/prosemirror)",
  "type": "module",
  "sideEffects": false,
  "funding": {
    "type": "GitHub Sponsors \u2764",
    "url": "https://github.com/sponsors/dmonad"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "dist": "npm run clean && PRODUCTION=1 tsc --skipLibCheck --noEmit false && test -e dist/src/index.d.ts",
    "prepare": "npm run dist",
    "test": "node ./tests/index.node.js",
    "test:browser": "rollup -c && node ./scripts/browser-tests.js",
    "test:debug": "node --inspect-brk ./tests/index.node.js",
    "lint": "standard && tsc --skipLibCheck",
    "watch": "rollup -wc",
    "debug": "concurrently '0serve -o test.html' 'npm run watch'",
    "preversion": "npm run dist",
    "start": "concurrently '0serve -o demo/prosemirror.html' 'npm run watch'"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./src/index.js"
    },
    "./indexeddb": {
      "types": "./dist/src/indexeddb.d.ts",
      "default": "./src/indexeddb.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/*",
    "!dist/test.*",
    "src/*",
    "./global.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wizzboy55/y-prosemirror.git"
  },
  "keywords": [
    "Yjs"
  ],
  "author": "Kevin Jahns <kevin.jahns@protonmail.com>",
  "license": "MIT",
  "standard": {
    "ignore": [
      "/dist",
      "/node_modules",
      "/docs"
    ]
  },
  "bugs": {
    "url": "https://github.com/wizzboy55/y-prosemirror/issues"
  },
  "homepage": "https://github.com/wizzboy55/y-prosemirror#readme",
  "dependencies": {
    "lib0": "1.0.0-rc.22"
  },
  "peerDependencies": {
    "@y/protocols": "1.0.6-rc.1",
    "@y/y": "14.0.0-rc.23",
    "prosemirror-model": "^1.7.1",
    "prosemirror-state": "^1.2.3",
    "prosemirror-view": "^1.9.10"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.8",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@y/prosemirror": "file:./",
    "@y/protocols": "1.0.6-rc.1",
    "@y/websocket": "4.0.0-rc.2",
    "@y/y": "14.0.0-rc.23",
    "concurrently": "^10.0.3",
    "fake-indexeddb": "^6.0.0",
    "http-server": "^14.1.1",
    "jsdom": "^29.0.2",
    "playwright-core": "^1.50.0",
    "prosemirror-example-setup": "^1.2.1",
    "prosemirror-model": "^1.18.1",
    "prosemirror-schema-basic": "^1.2.0",
    "prosemirror-state": "^1.4.1",
    "prosemirror-test-builder": "1.1.1",
    "prosemirror-transform": "^1.6.0",
    "prosemirror-view": "^1.26.2",
    "rollup": "^4.52.5",
    "standard": "^17.0.0",
    "typescript": "^5.9.3",
    "yjs13": "npm:yjs@^13.6.31"
  },
  "engines": {
    "npm": ">=8.0.0",
    "node": ">=16.0.0"
  }
}
